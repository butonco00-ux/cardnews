  "card_items": [
    [
      {
        "level": 1,
        "marker": "",
        "text": "유치권의 개념",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "“유치권”이란 타인의 물건 또는 유가증권을 점유한 자가 그 물건이나 유가증권에 관하여 생긴 채권이 변제기에 있는 경우에 변제를 받을 때까지 그 물건 또는 유가증권을 유치할 권리를 말합니다( 「민법」 제320조 제1항).",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "유치권자는 채권전부의 변제를 받을 때까지 유치물전부에 대하여 그 권리를 행사할 수 있습니다( 「민법」 제321조 ).",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "유치권과 동시이행항변권의 차이",
        "cont": false
      }
    ],
    [
      {
        "level": "table",
        "marker": "",
        "text": "⟦표1⟧",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "유치권의 성립요건",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "타인소유의 물건이나 유가증권",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "유치물이 타인의 물건(부동산 및 동산) 또는 유가증권이어야 합니다( 「민법」 제320조 제1항 참조).",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "적법한 점유일 것",
        "cont": false
      }
    ],
    [
      {
        "level": 1,
        "marker": "",
        "text": "유치권은 유치하려는 목적물의 점유가 필요하며, 점유는 간접점유로도 가능합니다",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "(대법원 2002.11.27. 선고 2002마3516 판결)",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": ". 또한 그 점유가 불법행위로 인한 경우(예: 점유침탈한 경우)에는 적용되지 않습니다( 「민법」 제320조 제1항 및 제2항 참조).",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "채권의 변제기가 도래할 것",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "유치권이 성립하려면 물건이나 유가증권에 관하여 생긴 채권의 변제기가 도래해야 합니다( 「민법」 제320조 제1항 참조).",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "유치권 배제특약이 없을 것",
        "cont": false
      }
    ],
    [
      {
        "level": 1,
        "marker": "",
        "text": "당사자간에 유치권을 배제한다는 특약이 없어야 합니다. 유치권은 채권자의 이익을 보호하기 위한 법정담보물권으로서, 당사자는 미리 유치권의 발생을 막는 특약을 할 수 있고 이러한 특약은 유효하며, 이러한 특약에 따른 효력은 특약의 상대방뿐 아니라 그 밖의 사람도 주장할 수 있습니다",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "(대법원 2018.1.24. 선고 2016다234043 판결)",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "채권과 목적물 사이에 견련관계가 있을 것",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "유치권이 성립하기 위해서는 채권이 유치권의 목적물에 관하여 생긴 채권이어야 합니다( 「민법」 제320조 제1항 참조).",
        "cont": false
      },
      {
        "level": "note",
        "marker": "※",
        "text": "견련관계가 부정되는 경우",
        "cont": false
      }
    ],
    [
      {
        "level": 2,
        "marker": "▪",
        "text": "임대인과 임차인 사이에 건물명도시 권리금을 반환하기로 하는 약정이 있었다 하더라도 그와 같은 권리금반환청구권은 건물에 관하여 생긴 채권이라 할 수 없으므로 그와 같은 채권을 가지고 건물에 대한 유치권을 행사할 수 없습니다",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "(대법원 1994.10.14. 선고 93다62119 판결)",
        "cont": false
      },
      {
        "level": 2,
        "marker": "▪",
        "text": "甲(갑)이 건물 신축공사 수급인인 乙(을) 주식회사와 체결한 약정에 따라 공사현장에 시멘트와 모래 등의 건축자재를 공급한 사안에서, 甲(갑)의 건축자재대금채권은 매매계약에 따른 매매대금채권에 불과할 뿐 건물 자체에 관하여 생긴 채권이라고 할 수는 없습니다",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "(대법원 2012.1.26. 선고 2011다96208 판결)",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "유치권의 효력",
        "cont": false
      }
    ],
    [
      {
        "level": 1,
        "marker": "",
        "text": "유치권자의 권리",
        "cont": false
      }
    ],
    [
      {
        "level": "table",
        "marker": "",
        "text": "⟦표2:1-3⟧",
        "cont": false
      }
    ],
    [
      {
        "level": "table",
        "marker": "",
        "text": "⟦표2:4-4⟧",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "유치권자의 의무",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "유치권자는 선량한 관리자의 주의로 유치물을 점유해야 합니다( 「민법」 제324조 제1항).",
        "cont": false
      },
      {
        "level": "system",
        "marker": "",
        "text": "(중략) 전체 내용은 원문에서 확인하세요",
        "cont": false
      }
    ]
  ],
