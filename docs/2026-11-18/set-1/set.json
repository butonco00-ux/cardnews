  "card_items": [
    [
      {
        "level": 0,
        "marker": "□",
        "text": "국토교통부(장관 홍지선)는 전국 표본 6.1만 가구를 대상으로 조사한 2025년도 주거실태조사 결과를 발표하였다.",
        "cont": false
      },
      {
        "level": 1,
        "marker": "ㅇ",
        "text": "주거실태조사는 국민 주거생활에 관한 전반적인 사항을 파악하고, 주택정책 수립 등에 참고하기 위해 매년 실시하는 표본조사로서 주요 조사결과는 다음과 같다.",
        "cont": false
      },
      {
        "level": 1,
        "marker": "ㅇ",
        "text": "주거실태조사는 2025년부터 조사환경 변화에 맞춰 대면조사와 함께 비대면조사도 병행하여 조사하였으며, 5.5만 가구는 대면으로, 6천 가구는 비대면으로 조사했다.",
        "cont": false
      }
    ],
    [
      {
        "level": 0,
        "marker": "□",
        "text": "2025년도 주거실태조사 결과(요약)",
        "cont": false
      },
      {
        "level": "note",
        "marker": "※",
        "text": "’24년 대비 주거환경은 개선, 주거비 부담은 증가",
        "cont": false
      },
      {
        "level": 1,
        "marker": "ㅇ",
        "text": "자가보유율 62.0% 및 자가점유율 59.1%",
        "cont": false
      },
      {
        "level": 2,
        "marker": "-",
        "text": "’24년 대비 증가, 자가보유율(61.4%→62.0%), 자가점유율(58.4%→59.1%)",
        "cont": false
      },
      {
        "level": 1,
        "marker": "ㅇ",
        "text": "자가가구의 연소득 대비 주택가격 비율 6.3배",
        "cont": false
      },
      {
        "level": 2,
        "marker": "-",
        "text": "’24년 대비 동일, 6.3배→6.3배(중위수 기준)",
        "cont": false
      },
      {
        "level": 1,
        "marker": "ㅇ",
        "text": "임차가구의 월소득 대비 월임대료 비율 17.0%",
        "cont": false
      },
      {
        "level": 2,
        "marker": "-",
        "text": "’24년 대비 증가, 15.8%→17.0%(중위수 기준)",
        "cont": false
      },
      {
        "level": 1,
        "marker": "ㅇ",
        "text": "1인당 주거면적 38.2m2",
        "cont": false
      },
      {
        "level": 2,
        "marker": "-",
        "text": "’24년 대비 증가 36.0㎡→38.2㎡",
        "cont": false
      },
      {
        "level": 1,
        "marker": "ㅇ",
        "text": "최저주거기준 미달가구 비중 3.6%",
        "cont": false
      },
      {
        "level": 2,
        "marker": "-",
        "text": "’24년 대비 감소, 3.8%→3.6%",
        "cont": false
      }
    ]
  ],
