  "card_items": [
    [
      {
        "level": 1,
        "marker": "",
        "text": "조건의 개념",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "“조건”이란 장래에 어떤 사실이 일어나는지에 따라 법률행위의 효력이 발생하거나 소멸하는 법률행위의 부관을 말합니다(『",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "국가법령정보센터, 법령용어사전",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "』 참조).",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "조건의 종류(『",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "국가법령정보센터, 법령용어사전",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "』 참조)",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "구분",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "내용",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "정지조건과 해제조건",
        "cont": false
      }
    ],
    [
      {
        "level": 1,
        "marker": "",
        "text": "정지조건",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "▪ 조건성취로 법률행위의 효력이 생겨 불확실한 상태를 ‘정지’시키는 조건",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "▪ 예: 취직을 하면 자동차를 사주겠다는 약정을 하는 경우",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "해제조건",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "▪ 조건성취로 법률행위의 효력이 사라져 역시 불확실한 상태를 ‘해제’시키는 조건",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "▪ 예: 며느리에게 차를 사주면서 이혼하면 차를 되돌려줄 것을 약정하는 경우",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "수의조건과",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "비수의조건",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "수의조건",
        "cont": false
      }
    ],
    [
      {
        "level": 1,
        "marker": "",
        "text": "▪ 조건의 성취가 당사자 일방의 자유의사에만 맡겨져 있는 조건",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "▪ 예: ‘채무자가 원한다면 ’이라는 조건을 붙인 경우",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "비수의조건",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "▪ 조건의 성취가 당사자 일방의 자유의사에만 의존하지 않는 조건",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "▪ 예: ‘내년에 홍수가 난다면’이라는 조건을 붙인 경우 가장조건",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "불법조건",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "▪ 선량한 풍속이나 기타 사회질서에 위반한 조건으로서, 불법조건이 붙어 있는 법률행위는 무효입니다( 「민법」 제151조 제1항).",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "기성조건",
        "cont": false
      }
    ],
    [
      {
        "level": 1,
        "marker": "",
        "text": "▪ 법률행위 당시 이미 성취한 것인 조건으로서, 그 조건이 정지조건이면 조건없는 법률행위로 하고 해제조건이면 그 법률행위는 무효입니다( 「민법」 제151조 제2항).",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "불능조건",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "▪ 법률행위의 당시에 이미 성취할 수 없는 조건으로서, 그 조건이 해제조건이면 조건없는 법률행위로 하고 정지조건이면 그 법률행위는 무효입니다( 「민법」 제151조 제3항).",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "조건과 친하지 않은 법률행위(『",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "국가법령정보센터, 법령용어사전",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "』 참조)",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "구분",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "내용",
        "cont": false
      }
    ],
    [
      {
        "level": 1,
        "marker": "",
        "text": "신분행위",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "▪ 혼인, 입양, 인지, 상속의 승인·포기와 같은 친족법·상속법상의 행위에는 조건을 붙이지 못합니다.",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "단독행위",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "▪ 단독행위인 상계와 같은 형성권의 행사( 「민법」 제493조",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "제1항)에는 조건을 붙이지 못하는 것이 원칙입니다. 다만, 유증이나 채무의 면제와 같이 상대방의 동의가 있거나 상대방에게 이익만을 주는 단독행위에는 조건을 붙일 수 있습니다.",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "어음·수표행위",
        "cont": false
      }
    ],
    [
      {
        "level": 1,
        "marker": "",
        "text": "▪ 유통의 안전을 위해 어음·수표행위에는 조건을 붙이는 것이 허용되지 않습니다( 「어음법」 제12조 제26조 「수표법」 제15조 제54조",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "참조).",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "조건의 성취와 불성취",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "조건의 성취로 인하여 불이익을 받을 당사자가 신의성실에 반하여 조건의 성취를 방해한 때에는 상대방은 그 조건이 성취한 것으로 주장할 수 있습니다( 「민법」 제150조 제1항).",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "조건의 성취로 인하여 이익을 받을 당사자가 신의성실에 반하여 조건을 성취시킨 때에는 상대방은 그 조건이 성취하지 않은 것으로 주장할 수 있습니다( 「민법」 제150조 제2항).",
        "cont": false
      }
    ],
    [
      {
        "level": 1,
        "marker": "",
        "text": "조건부 권리의 침해금지 및 처분 등",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "조건 있는 법률행위의 당사자는 조건의 성부가 미정한 동안에 조건의 성취로 인하여 생길 상대방의 이익을 해하지 못합니다( 「민법」 제148조 ).",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "조건의 성취가 미정한 권리의무는 일반규정에 의하여 처분, 상속, 보존 또는 담보로 할 수 있습니다( 「민법」 제149조 ).",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "조건 성취의 효과",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "정지조건 있는 법률행위는 조건이 성취한 때로부터 그 효력이 생기며, 해제조건 있는 법률행위는 조건이 성취한 때로부터 그 효력을 잃습니다( 「민법」 제147조 제1항 및 제2항).",
        "cont": false
      }
    ],
    [
      {
        "level": 1,
        "marker": "",
        "text": "다만, 당사자가 조건성취의 효력을 그 성취전에 소급하게 할 의사를 표시한 때에는 그 의사에 따릅니다( 「민법」 제147조 제3항).",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "기한",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "기한의 개념",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "“기한”이란 법률행위 효력의 발생이나 소멸, 채무의 이행이 장래에 발생하는 것이 확실한 사실에 의존케 하는 ‘법률행위의 부관’을 말합니다(『",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "국가법령정보센터, 법령용어사전",
        "cont": false
      },
      {
        "level": 1,
        "marker": "",
        "text": "』 참조).",
        "cont": false
      },
      {
        "level": "system",
        "marker": "",
        "text": "(중략) 전체 내용은 원문에서 확인하세요",
        "cont": false
      }
    ]
  ],
